# AcadeXMatch settings. Create a file named ".env.local" in the project folder (next to package.json),
# copy the lines below into it and fill in your values, then restart the app (npm run dev / npm start).
# .env.local is private: never share or commit it.

# ---- Database ----
# On GoDaddy Node.js Hosting these are filled in automatically for the app's MySQL database
# (DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD) — you do not need to add them there.
# Locally, leave them out to keep data in the "data" folder, or point them at your own MySQL server.
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=acadexmatch
# DB_USER=acadexmatch
# DB_PASSWORD=your-password

# Public address of the site, used in links inside emails.
APP_URL=http://localhost:3000

# ---- Email (Gmail example) ----
# 1. Turn on 2-Step Verification for the Gmail account.
# 2. Create an App Password: Google Account → Security → App passwords.
# 3. Put the 16-character app password below (no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourname@gmail.com
SMTP_PASS=your16charapppassword
MAIL_FROM=AcadeXMatch <yourname@gmail.com>

# ---- Email through an API (use this if your host blocks email ports 465/587) ----
# Some hosts (e.g. GoDaddy Node.js hosting) block outgoing SMTP. Then send over HTTPS instead:
#  Brevo (brevo.com, free 300 emails/day): Settings → SMTP & API → API keys → create a key;
#    Senders & domains → add info@acadexmatch.com as a sender and verify it (and the domain, recommended).
#  or Resend (resend.com): add and verify the domain acadexmatch.com, then create an API key.
# When EMAIL_API is set it is used instead of SMTP.
# EMAIL_API=brevo
# EMAIL_API_KEY=xkeysib-xxxxxxxx
# MAIL_FROM=AcadeXMatch <info@acadexmatch.com>

# ---- Razorpay (online payments) ----
# Razorpay Dashboard → Account & Settings → API Keys. Start with the Test Mode keys (rzp_test_...);
# switch to the Live keys after Razorpay activates your account. Leave these out to keep the
# manual "request upgrade" flow instead of online payment.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# Optional but recommended once the site has a public https address:
# Dashboard → Webhooks → Add: URL https://www.acadexmatch.com/api/payments/webhook, events
# payment.captured, order.paid, payment.failed, refund.created, refund.processed, refund.failed,
# and the same secret here. It confirms payments even if the buyer closes the browser and records refunds.
# RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-secret

# Optional: set to 1 to stop the daily vacancy scrape from running inside the web server.
# ACAD_DISABLE_SCHEDULER=1

# ---- Search engines (SEO) ----
# Canonical address used in canonical tags, sitemap.xml and structured data. Must be the host the site
# finally serves after redirects (today https://www.acadexmatch.com redirects to https://acadexmatch.com).
# SITE_URL=https://acadexmatch.com
# Google Search Console → Add property → URL prefix → HTML tag: copy only the content="…" value.
# GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Add site → HTML Meta Tag: copy only the content="…" value of msvalidate.01.
# BING_SITE_VERIFICATION=
# Google Analytics 4 measurement ID (G-XXXXXXX). Leave empty to load no analytics.
# GA_MEASUREMENT_ID=
# IndexNow key (8–128 letters/digits/dashes, e.g. a random UUID). Served at /<key>.txt; changed vacancies are
# then announced to Bing and other IndexNow search engines automatically.
# INDEXNOW_KEY=

# ---- Sign-in security (see docs/AUTH_AND_NOTIFICATIONS.md) ----
# Secret for signing Google/Microsoft sign-in state, SMS-code digests and unsubscribe links.
# At least 32 random characters, e.g. the output of:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=
# Administrator sign-in asks for a code by email once an email has been delivered in the last 30 days. Set to off to skip it (not recommended).
# ADMIN_EMAIL_CODE=on
# Applying and posting vacancies need a confirmed email once email delivery is proven: auto (default) | on | off
# REQUIRE_VERIFIED_EMAIL=auto
# Password-reset link lifetime in minutes (default 30).
# PASSWORD_RESET_MINUTES=30

# ---- SMS codes (sign-in by mobile number, phone confirmation, password recovery) ----
# Without these the SMS options are hidden; nothing is ever pretended to be sent.
# MSG91 (India, DLT): DLT-registered sender header + an approved OTP template whose variable is the code,
# e.g. "##OTP## is your AcadeXMatch verification code. It is valid for 5 minutes. Do not share it. - AcadeXMatch"
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER=ACADXM
# MSG91_DLT_TE_ID=
# MSG91_OTP_VAR=OTP
# Or Twilio (outside India, or with Twilio's own DLT registration for India):
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1xxxxxxxxxx      (or TWILIO_MESSAGING_SERVICE_SID=MG...)
# Code rules (defaults shown): length, minutes valid, seconds before a new code, wrong tries, codes per number per hour/day, per IP per hour.
# OTP_LENGTH=6
# OTP_EXPIRY_MINUTES=5
# OTP_RESEND_SECONDS=60
# OTP_MAX_ATTEMPTS=5
# OTP_MAX_PER_HOUR=5
# OTP_MAX_PER_DAY=10
# OTP_MAX_PER_IP_HOUR=20

# ---- Continue with Google / Microsoft ----
# Buttons appear only when both values of a provider are set.
# Redirect URIs to register:  https://acadexmatch.com/api/auth/oauth/google/callback
#                              https://acadexmatch.com/api/auth/oauth/microsoft/callback
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common        (common = personal + work/school accounts; consumers; organizations; or a tenant id)
# Optional: base address for the callback URLs if it differs from APP_URL.
# OAUTH_REDIRECT_BASE=https://acadexmatch.com

# ---- Email delivery events and test copies ----
# Webhook from Brevo/Resend for delivered / bounced / spam reports: https://acadexmatch.com/api/email-events?key=<this secret>
# EMAIL_WEBHOOK_SECRET=choose-a-long-random-secret
# On a test copy of the site, send every email to one inbox instead of the real recipients:
# EMAIL_REDIRECT_TO=you@example.com
# Interview reminders: hours before the interview (default 24 and 1).
# INTERVIEW_REMINDER_HOURS=24,1
